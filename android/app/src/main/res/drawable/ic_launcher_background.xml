<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Matches the brown 3D-dome mark used as the
  WatShop Cafe brand: vertical light→dark coffee gradient, a cream
  stripe near the top, and a small highlight dot in the upper-right
  corner. The W glyph lives in ic_launcher_foreground.xml so launchers
  that mask differently (circle, squircle, square) can still composite
  the two layers correctly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Brown coffee gradient — top-left highlight to bottom-right shadow -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#C49A78"
                android:centerColor="#8B6644"
                android:endColor="#3E2D24" />
        </aapt:attr>
    </path>

    <!-- Cream horizontal stripe near the top (matches the dome accent) -->
    <path android:fillColor="#E8C9A4"
          android:pathData="M0,28 L108,28 L108,32 L0,32 Z" />
    <path android:fillColor="#3E2D24" android:fillAlpha="0.35"
          android:pathData="M0,32 L108,32 L108,34 L0,34 Z" />

    <!-- Highlight dot, upper-right corner of the dome -->
    <path android:fillColor="#E8C9A4"
          android:pathData="M86,17 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.55"
          android:pathData="M84.5,15.5 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />

    <!-- Bottom shadow vignette for the 3D dome look -->
    <path android:pathData="M0,72 L108,72 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="72"
                android:endX="54" android:endY="108"
                android:startColor="#003E2D24"
                android:endColor="#553E2D24" />
        </aapt:attr>
    </path>
</vector>
